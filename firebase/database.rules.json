{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['state', 'at']) && (newData.child('state').val() == 'online' || newData.child('state').val() == 'offline'))"
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['at']) || !newData.exists()"
        }
      }
    },
    "mehfil": {
      "$chatId": {
        ".read": "auth != null",
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['at']) || !newData.exists()"
          }
        },
        "media": {
          ".write": "auth != null && root.child('mehfil').child($chatId).child('participants').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['by', 'at']) && newData.child('by').val() == auth.uid"
        },
        "reactions": {
          ".write": "auth != null && root.child('mehfil').child($chatId).child('participants').child(auth.uid).exists()",
          "$rid": {
            ".validate": "newData.hasChildren(['emoji', 'by', 'at']) && newData.child('by').val() == auth.uid"
          }
        },
        "chat": {
          ".write": "auth != null && root.child('mehfil').child($chatId).child('participants').child(auth.uid).exists()",
          "$mid": {
            ".validate": "newData.hasChildren(['text', 'by', 'at']) && newData.child('by').val() == auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
          }
        },
        "ring": {
          ".write": "auth != null && (!newData.exists() || newData.child('fromUid').val() == auth.uid || data.exists() && data.child('fromUid').val() == auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['fromUid', 'chatId', 'ts', 'expiresAt']) && newData.child('fromUid').val() == auth.uid && newData.child('chatId').val() == $chatId)"
        },
        "ringAck": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['status', 'at']) && newData.child('status').isString())"
          }
        }
      }
    },
    "mehfilInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$chatId": {
          ".write": "auth != null && (newData.child('fromUid').val() == auth.uid || (!newData.exists() && auth.uid == $uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['fromUid', 'chatId', 'ts', 'expiresAt']) && newData.child('fromUid').val() == auth.uid && newData.child('chatId').val() == $chatId)"
        }
      }
    },
    "games": {
      "$gameType": {
        "$gameId": {
          ".read": "auth != null && (data.child('players').child(auth.uid).exists() || data.child('playerA').val() == auth.uid || data.child('playerB').val() == auth.uid || !data.exists())",
          ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || data.child('playerA').val() == auth.uid || data.child('playerB').val() == auth.uid)",
          "hands": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      }
    }
  }
}
