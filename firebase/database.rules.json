{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['state', 'at']) && (newData.child('state').val() == 'online' || newData.child('state').val() == 'offline'))"
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['at']) || !newData.exists()"
        }
      }
    },
    "mehfilMembers": {
      "$chatId": {
        ".read": "auth != null && data.child(auth.uid).val() == true",
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true)",
          ".write": false
        }
      }
    },
    "mehfil": {
      "$chatId": {
        ".read": "auth != null && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true",
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true && (!root.child('mehfil').child($chatId).child('removed').child(auth.uid).exists() || root.child('mehfil').child($chatId).child('removed').child(auth.uid).child('until').val() < now)",
            ".validate": "newData.hasChildren(['at']) || !newData.exists()"
          }
        },
        "roomHost": {
          ".write": "auth != null && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true && ((!data.exists() && newData.child('uid').val() == auth.uid) || (data.child('uid').val() == auth.uid) || (!newData.exists() && data.child('uid').val() == auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'at']) && newData.child('uid').isString())"
        },
        "roles": {
          "$uid": {
            ".write": "auth != null && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true && ((auth.uid == $uid && (!newData.exists() || newData.child('role').val() == 'speaker' || newData.child('role').val() == 'listener')) || (root.child('mehfil').child($chatId).child('roomHost').child('uid').val() == auth.uid))",
            ".validate": "!newData.exists() || (newData.hasChildren(['role', 'at']) && (newData.child('role').val() == 'speaker' || newData.child('role').val() == 'listener'))"
          }
        },
        "removed": {
          "$uid": {
            ".write": "auth != null && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true && root.child('mehfil').child($chatId).child('roomHost').child('uid').val() == auth.uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['by', 'at', 'until']) && newData.child('by').val() == auth.uid)"
          }
        },
        "moderation": {
          "$uid": {
            ".write": "auth != null && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true && (auth.uid == $uid || root.child('mehfil').child($chatId).child('roomHost').child('uid').val() == auth.uid)",
            ".validate": "!newData.exists() || newData.hasChildren(['at'])"
          }
        },
        "media": {
          ".write": "auth != null && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true",
          ".validate": "newData.hasChildren(['by', 'at']) && newData.child('by').val() == auth.uid"
        },
        "reactions": {
          ".write": "auth != null && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true",
          "$rid": {
            ".validate": "newData.hasChildren(['emoji', 'by', 'at']) && newData.child('by').val() == auth.uid"
          }
        },
        "chat": {
          ".write": "auth != null && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true",
          "$mid": {
            ".validate": "newData.hasChildren(['text', 'by', 'at']) && newData.child('by').val() == auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
          }
        },
        "ring": {
          ".write": "auth != null && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true && (!newData.exists() || newData.child('fromUid').val() == auth.uid || data.exists() && data.child('fromUid').val() == auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['fromUid', 'chatId', 'ts', 'expiresAt']) && newData.child('fromUid').val() == auth.uid && newData.child('chatId').val() == $chatId)"
        },
        "ringAck": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true",
            ".validate": "!newData.exists() || (newData.hasChildren(['status', 'at']) && (newData.child('status').val() == 'accepted' || newData.child('status').val() == 'declined' || newData.child('status').val() == 'timeout'))"
          }
        }
      }
    },
    "mehfilInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$chatId": {
          ".write": "auth != null && ((!newData.exists() && auth.uid == $uid) || (newData.child('fromUid').val() == auth.uid && root.child('mehfilMembers').child($chatId).child(auth.uid).val() == true))",
          ".validate": "!newData.exists() || (newData.hasChildren(['fromUid', 'chatId', 'ts', 'expiresAt']) && newData.child('fromUid').val() == auth.uid && newData.child('chatId').val() == $chatId)"
        }
      }
    },
