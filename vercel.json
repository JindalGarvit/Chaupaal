{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.googletagmanager.com https://www.google.com https://download.agora.io https://www.youtube.com https://s.ytimg.com https://unpkg.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; media-src 'self' https://aac.saavncdn.com https://preview.saavncdn.com https://*.saavncdn.com https://audio-ssl.itunes.apple.com https://*.itunes.apple.com https://*.mzstatic.com https: blob: data:; connect-src 'self' https://aac.saavncdn.com https://preview.saavncdn.com https://*.saavncdn.com https://audio-ssl.itunes.apple.com https://*.itunes.apple.com https://*.mzstatic.com https: wss: blob:; frame-src 'self' https://www.youtube.com https://www.google.com https://*.firebaseapp.com https://checkout.razorpay.com https://api.razorpay.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), autoplay=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/duniya-posts", "destination": "/api/stories" },
    { "source": "/api/ai", "destination": "/api/anthropic" },

    {
      "source": "/profile/(.*)",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i).*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|Discordbot|TelegramBot|Googlebot|bingbot|Applebot|Preview|Embedly).*" } }],
      "destination": "/api/stories?og=1&kind=profile&id=$1"
    },
    {
      "source": "/u/(.*)",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i).*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|Discordbot|TelegramBot|Googlebot|bingbot|Applebot|Preview|Embedly).*" } }],
      "destination": "/api/stories?og=1&kind=profile&id=$1"
    },
    {
      "source": "/post/(.*)",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i).*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|Discordbot|TelegramBot|Googlebot|bingbot|Applebot|Preview|Embedly).*" } }],
      "destination": "/api/stories?og=1&kind=post&id=$1"
    },
    {
      "source": "/p/(.*)",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i).*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|Discordbot|TelegramBot|Googlebot|bingbot|Applebot|Preview|Embedly).*" } }],
      "destination": "/api/stories?og=1&kind=post&id=$1"
    },
    {
      "source": "/challenge/(.*)",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i).*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|Discordbot|TelegramBot|Googlebot|bingbot|Applebot|Preview|Embedly).*" } }],
      "destination": "/api/stories?og=1&kind=challenge&id=$1"
    },
    {
      "source": "/story/(.*)",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i).*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|Discordbot|TelegramBot|Googlebot|bingbot|Applebot|Preview|Embedly).*" } }],
      "destination": "/api/stories?og=1&kind=story&id=$1"
    },

    {
      "source": "/invite/(.*)",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "(?i).*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|Discordbot|TelegramBot|Googlebot|bingbot|Applebot|Preview|Embedly).*" } }],
      "destination": "/api/stories?og=1&kind=invite&id=$1"
    },

    { "source": "/profile/(.*)", "destination": "/index.html" },
    { "source": "/post/(.*)", "destination": "/index.html" },
    { "source": "/chat/(.*)", "destination": "/index.html" },
    { "source": "/u/(.*)", "destination": "/index.html" },
    { "source": "/p/(.*)", "destination": "/index.html" },
    { "source": "/c/(.*)", "destination": "/index.html" },
    { "source": "/story/(.*)", "destination": "/index.html" },
    { "source": "/challenge/(.*)", "destination": "/index.html" },
    { "source": "/invite/(.*)", "destination": "/index.html" },
    { "source": "/join/g/(.*)", "destination": "/index.html" },
    { "source": "/join/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/refresh-category-cache.js": {
      "maxDuration": 300
    },
    "api/chaupaal-scheduler.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/chaupaal-scheduler",
      "schedule": "0 15 * * *"
    }
  ]
}
