# === AI env matrix (P8) — never commit real keys ===
# Master LLM kill-switch — MUST be exactly "true" for callAI() / labeling / category cron.
# Unset/false → deterministic P6/P7 path only (no user-facing errors).
AI_FEATURES_ENABLED=false

# Provider swap (7A). Callers never branch on vendor — only AI_PROVIDER + keys.
# Values: anthropic | openai-compatible | openai | grok | xai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Also accepted as Anthropic_API_key for legacy Vercel naming.

# OpenAI-compatible (Grok / cheap / Chinese OpenAI-shaped APIs):
# OPENAI_API_KEY=   (or AI_API_KEY / GROK_API_KEY)
# OPENAI_BASE_URL=https://api.openai.com/v1
# For xAI Grok example: OPENAI_BASE_URL=https://api.x.ai/v1 + GROK_API_KEY

# Tier → model overrides (resolved per provider; defaults in server-lib/ai-config.js):
# AI_MODEL_FAST=claude-haiku-4-5-20251001
# AI_MODEL_BALANCED=claude-sonnet-4-6
# For openai-compatible defaults: gpt-4o-mini / gpt-4o (or set the two above).

# Enrichment jobs (scheduler → server-lib/ai-enrichment.js):
# AI_JOBS_PAUSED=true          # global pause for labeling / profile enrich
# AI_DAILY_CALL_CAP=200        # UTC-day call budget shared with category cron

# Category cache cron (api/refresh-category-cache.js) — default PAUSED (safe).
# Hobby: vercel.json already schedules GET /api/refresh-category-cache daily `0 2 * * *`
# (~07:30 IST ±59m). Separate from chaupaal-scheduler `0 15 * * *` (Goodnight).
# Unpause checklist (Vercel env — no keys in repo):
#   1. CATEGORY_CRON_PAUSED=false
#   2. AI_FEATURES_ENABLED=true
#   3. AI_JOBS_PAUSED unset/false (budgetAllows blocks when enrichment pause is on)
#   4. Provider key for AI_PROVIDER (ANTHROPIC_API_KEY or OPENAI_*/GROK_*)
#   5. CRON_SECRET + FIREBASE_SERVICE_ACCOUNT_JSON set
#   6. Optional AI_DAILY_CALL_CAP (default 200; shared with enrichment — cron bumps budget)
# Paused / AI-off / budget → cron returns 200 no-op (no LLM spend; prior caches kept).
# Client live AI (CAT_LIVE_AI_PAUSED) is a hardcoded const in categories.js — flip in code to
# allow on-demand Claude when cache cold; separate from server cron unpause.
# CATEGORY_CRON_PAUSED=true
# Optional city / industry scopes for shareable Khabar/Sawaal cache (comma-separated, max 8 / 6):
# CAT_CACHE_CITIES=Mumbai,Delhi,Bengaluru
# CAT_CACHE_INDUSTRIES=Technology,Finance,Education
# Client already prefers city/industry-scoped cache docs when profile.currentCity / industry is set.
# Chaupaal scheduler: vercel.json cron → /api/chaupaal-scheduler (Bearer CRON_SECRET).
# Fixed Goodnight time for everyone: 8:30 PM IST = 15:00 UTC (`0 15 * * *`).
# Hobby: daily cron cadence only (±59m); multiple crons allowed per project.
CRON_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Web Push (FCM) — Firebase Console → Project settings → Cloud Messaging → Web Push certificates.
# Client fetches this via POST /api/media-config { action: 'fcm_config' }; never put the key in HTML.
# FIREBASE_VAPID_KEY is accepted as an alias.
FCM_VAPID_KEY=

# Cloudinary (Phase 2.5 media) — free tier, unsigned upload preset (no API secret in client).
# Dashboard → Settings → Upload → Add upload preset → Signing mode: Unsigned
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Outbound link safety (folded into POST /api/media-config action: check_url).
# Google Web Risk Lookup API — enable Web Risk API on the GCP project, create an API key.
# If unset or the call fails, Chaupaal falls back to local heuristics; links still show the leave-app interstitial.
GOOGLE_WEB_RISK_KEY=

# Music sharing (Baithak chat + Stories) — folded into POST /api/media-config
# Provider: jiosaavn (default). Swap later by adding providers/<name>.js + MUSIC_PROVIDER.
MUSIC_PROVIDER=jiosaavn
# Optional self-hosted / mirror of sumitkolhe/jiosaavn-api (default https://saavn.sumit.co)
# JIOSAAVN_API_BASE=https://saavn.sumit.co

# GIF / sticker / meme / clip live search (POST /api/media-config action: gif_search + kind).
# Partner panel: https://partner.klipy.com → Add Platform (Web). Key goes in the URL path
# (never put this in HTML/meta/window). Client also needs feature_flags/gif_live_search.enabled.
# Unset → soft { configured:false }; picker uses local curated Giphy pack / emoji stickers.
KLIPY_API_KEY=

# Mehfil (Agora RTC) — token mint via POST /api/media-config action: agora_token
# Create a project at console.agora.io → copy App ID + App Certificate.
# Client defaults Mehfil ON (chat + YouTube work without keys). Voice needs both vars.
# Kill-switch: set Firestore feature_flags/mehfil.enabled = false.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# YouTube Data API v3 — Mehfil typed search (server-only; never put in HTML).
# Console → APIs & Services → enable YouTube Data API v3 → create an API key.
# Unset → youtube_search returns { results: [], configured: false }; paste-a-link still works.
# Playback of a known video id does not use this quota. Searches are cached (Redis/Firestore).
YOUTUBE_API_KEY=

# Upstash Redis (Phase 4 rate limiting) — free tier REST API
# Console → Redis → REST API → copy URL + token
# Unset → rate limits degrade open (allow). Used by gif_search, media_lookup, ai, etc.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Embeddings (independent of AI_FEATURES_ENABLED) — adapter in server-lib/embeddings.js
# EMBED_PROVIDER=gemini|openai-compatible  (default gemini)
GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=text-embedding-004
# OPENAI_EMBED_MODEL=text-embedding-3-small  (when EMBED_PROVIDER=openai-compatible)
# textHash dedupe: unchanged profile/content text never re-embeds.
# Content embeddings (Infra I2): scheduler → runContentEmbeddingJob on public duniya/peepal
#   writes contentEmbedding { vector, textHash, model, provider, updatedAt }; ≤6/collection/tick.
#   Missing keys → enrichment reports embed_keys_missing; rank falls back to velocity/recency.
#   Rank consume: rankContentItems / Mashhoor / Prasidha / rank_content.

# People retrieval backend (server-lib/retrieve-rank.js) — default firestore-shards
# CHAUPAAL_RETRIEVAL_BACKEND=firestore-shards|vector-index
# vector-index: pool prefilter (≤12 shards / ≤96 entries) → hydrate ≤80 → cosine on
#   users.profileEmbedding; miss/error falls through to shards. People only (content = I2).
# CHAUPAAL_RETRIEVAL_BACKEND=firestore-shards

